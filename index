/* ---------- หน้ายอดคงเหลือ ---------- */
function renderBal(){
  const q=$('#bSearch').value.trim().toLowerCase(), m={};
  cacheRows.forEach(r => {
    const k=[r.fabric,r.color,r.unit].map(s=>String(s||'').trim().toLowerCase()).join('|');
    const b = m[k] ||= {fabric:r.fabric,color:r.color,unit:r.unit,rIn:0,rOut:0,qIn:0,qOut:0,last:'',photo:''};
    const s = r.type==='OUT'?'Out':'In';
    b['r'+s]+= +r.rolls||0; b['q'+s]+= +r.qty||0;
    if (r.date>=b.last){ b.last=r.date; }
    if (r.type==='IN' && (r.colors[0]||r.photos[0])) b.photo=r.colors[0]||r.photos[0];
  });
  let list=Object.values(m).filter(b=>!q||[b.fabric,b.color].join(' ').toLowerCase().includes(q));
  list.sort((a,b)=>a.fabric.localeCompare(b.fabric,'th')||String(a.color).localeCompare(String(b.color),'th'));
  if (!list.length){ $('#balList').innerHTML=`<div class="empty">${esc(t('empty'))}</div>`; return; }
  const cls = n => n<0?'neg':(n===0?'zero':'');
  $('#balList').innerHTML = `<table><thead><tr><th></th><th>${esc(t('fabric'))}</th>
    <th class="n">${esc(t('bIn'))}</th><th class="n">${esc(t('bOut'))}</th><th class="n">${esc(t('bBal'))}</th></tr></thead><tbody>
    ${list.map(b => { const rb=b.rIn-b.rOut, qb=b.qIn-b.qOut; return `<tr>
      <td>${b.photo?imgTag(b.photo):''}</td>
      <td><b>${esc(b.fabric)}</b><div class="sub" style="font-size:12px;color:var(--mute)">${esc(b.color||'')} · ${esc(t('bLast'))} ${esc(b.last)}</div></td>
      <td class="n">${b.rIn?fmtNum(b.rIn)+' '+esc(t('rollsShort'))+'<br>':''}${fmtNum(b.qIn)} ${esc(unitLabel(b.unit))}</td>
      <td class="n">${b.rOut?fmtNum(b.rOut)+' '+esc(t('rollsShort'))+'<br>':''}${fmtNum(b.qOut)}</td>
      <td class="n"><span class="${cls(rb)}">${(b.rIn||b.rOut)?fmtNum(rb)+' '+esc(t('rollsShort')):''}</span><br><b class="${cls(qb)}">${fmtNum(qb)}</b> ${esc(unitLabel(b.unit))}</td></tr>`; }).join('')}
    </tbody></table>`;
}

/* ---------- โหมดทดลอง ---------- */
function demoSave(p){
  const now=new Date(), id=p.type+'-'+now.getTime();
  p.items.forEach(it => demoDB.push({ts:now.toISOString(),id,date:p.date,type:p.type,recorder:p.recorder,partner:p.partner,ref:p.ref,
    fabric:it.fabric,color:it.color,lot:it.lot,rolls:+it.rolls||0,qty:+it.qty||0,unit:it.unit,order:it.order,customer:it.customer,purpose:it.purpose,photos:it.photos.slice(),colors:it.colorPhotos.slice(),bills:p.billPhotos.slice(),folder:'',pdf:'',note:p.note}));
  return {ok:true,id,folderUrl:''};
}

/* ---------- ใบปะหน้าผ้า ---------- */
let pr=null;
function recFromPayload(p,id,folder){
  return {type:p.type,date:p.date,partner:p.partner,ref:p.ref,recorder:p.recorder,id:id||'',folder:folder||'',
    items:p.items.map(it=>{ const c=(it.colorPhotos||[])[0], l=(it.photos||[])[0];
      return {fabric:it.fabric,color:it.color,lot:it.lot,rolls:+it.rolls||0,qty:+it.qty||0,unit:it.unit,order:it.order||'',customer:it.customer||'',purpose:it.purpose||'',img:c||l||'',kind:c?'color':(l?'label':'')}; })};
}
function recFromRows(id){
  const ls=(cacheRows||[]).filter(r=>r.id===id); if(!ls.length) return null; const h=ls[0];
  return {type:h.type,date:h.date,partner:h.partner,ref:h.ref,recorder:h.recorder,id:h.id,folder:h.folder,
    items:ls.map(l=>({fabric:l.fabric,color:l.color,lot:l.lot,rolls:l.rolls,qty:l.qty,unit:l.unit,order:l.order||'',customer:l.customer||'',purpose:l.purpose||'',
      img:(l.colors||[])[0]||l.photos[0]||'',kind:(l.colors||[])[0]?'color':(l.photos[0]?'label':'')}))};
}
function openPrint(rec,justSaved){
  pr={rec,copies:rec.items.map(()=>1)};
  $('#pmTitle').textContent=t(justSaved?'savedPrint':'printTitle');
  $('#pmShare').classList.add('hidden');
  renderPm(); $('#pm').style.display='flex';
}
function renderPm(){
  $('#pmList').innerHTML=pr.rec.items.map((it,i)=>`<div class="prow">${it.img?imgTag(it.img):'<div class="noimg">—</div>'}
    <div class="pn"><b>${esc(it.fabric)}</b><div class="sub">${esc([it.color,it.lot&&('Lot '+it.lot)].filter(Boolean).join(' · '))}${it.rolls?' · '+fmtNum(it.rolls)+' '+esc(t('rollsShort')):''}</div></div>
    <div class="stp"><button type="button" data-d="-1" data-ix="${i}">−</button><input type="number" inputmode="numeric" min="0" max="99" value="${pr.copies[i]}" data-ci="${i}"><button type="button" data-d="1" data-ix="${i}">＋</button></div></div>`).join('');
  updatePmBtn();
}
function updatePmBtn(){
  const n=pr.copies.reduce((a,b)=>a+b,0), b=$('#pmPrint');
  b.textContent=`🖨 ${t('print')} ${n} ${t('sheets')} (A4 ${Math.ceil(n/3)} ${t('pages')})`; b.disabled=!n;
}
$('#pmList').onclick=e=>{ const b=e.target.closest('button[data-d]'); if(!b) return; const i=+b.dataset.ix;
  pr.copies[i]=Math.max(0,Math.min(99,pr.copies[i]+(+b.dataset.d))); renderPm(); };
$('#pmList').oninput=e=>{ const i=e.target.dataset.ci; if(i==null) return; pr.copies[i]=Math.max(0,Math.min(99,parseInt(e.target.value)||0)); updatePmBtn(); };
$('#pmRolls').onclick=()=>{ pr.copies=pr.rec.items.map(it=>it.rolls>0?Math.min(99,Math.ceil(it.rolls)):1); renderPm(); };
$('#pmClose').onclick=()=>{ $('#pm').style.display='none'; };
$('#pm').onclick=e=>{ if(e.target.id==='pm') $('#pm').style.display='none'; };
$('#pmPrint').onclick=async()=>{
  busy(true,t('preparing'));
  await resolveImgs(pr.rec); buildLabels();
  await waitImgs($('#printArea')); busy(false);
  doPrint();
};
/* หน้าเว็บที่ถูกเปิดในกรอบ (preview / แอป) มักบล็อก window.print → เปิดหน้าต่างใหม่แล้วพิมพ์ */
function doPrint(){
  let inFrame=true; try{ inFrame = window.self!==window.top; }catch(e){}
  if (!inFrame){ window.print(); return; }
  const w = window.open('','_blank');
  if (!w){ window.print(); return; }
  w.document.write('<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ใบปะหน้าผ้า</title>'
    + '<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;600;700&display=swap" rel="stylesheet">'
    + '<style>' + document.querySelector('style').textContent + '</style></head>'
    + '<body style="margin:0;background:#fff"><div id="printArea" style="display:block">' + $('#printArea').innerHTML + '</div>'
    + '<script>window.onload=function(){setTimeout(function(){window.print()},500)}<\/script></body></html>');
  w.document.close();
}
/* ปุ่มพิมพ์บนหน้าฟอร์ม: พิมพ์จากข้อมูลที่กรอกอยู่ โดยยังไม่ต้องบันทึก */
$('#btnPrintNow').onclick = () => {
  const filled = items.filter(it => it.fabric.trim());
  if (!filled.length){ markErrors(); return toast(t('needFabric'),'bad'); }
  const p = { type, date:$('#fDate').value||today(), recorder:$('#fRecorder').value.trim(),
    partner:$('#fPartner').value.trim(), ref:$('#fRef').value.trim(),
    items: filled.map(it => ({fabric:it.fabric.trim(),color:it.color.trim(),lot:it.lot.trim(),rolls:it.rolls,qty:it.qty,unit:it.unit,order:it.order.trim(),customer:it.customer.trim(),purpose:it.purpose.trim(),photos:it.photos,colorPhotos:it.colorPhotos})) };
  openPrint(recFromPayload(p,'(ยังไม่บันทึก)',''), false);
  $('#pmTitle').textContent = t('previewTitle');
};
function qrImg(text){
  try{ if(typeof qrcode!=='function'||!text) return ''; const q=qrcode(0,'M'); q.addData(text); q.make(); return `<img src="${q.createDataURL(4,0)}" alt="">`; }catch(e){ return ''; }
}
function thDate(s){ const d=new Date(s+'T00:00:00'); return isNaN(d)?s:d.toLocaleDateString('th-TH',{day:'numeric',month:'short',year:'numeric'}); }
function buildLabels(canvas){
  const {rec,copies}=pr, out=rec.type==='OUT', N=rec.items.length, qr=qrImg(rec.folder);
  let html='';
  rec.items.forEach((it,i)=>{ const c=copies[i];
    for(let k=1;k<=c;k++){ const tag=c>1?(it.rolls===c?`ม้วนที่ ${k}/${c}`:`ใบ ${k}/${c}`):''; html+=labelHtml(rec,it,i,N,tag,qr,out,canvas); } });
  $('#printArea').innerHTML=html;
}
function labelHtml(rec,it,i,N,tag,qr,out,canvas){
  const src=it.img?(it.img.startsWith('data:')?it.img:thumb(it.img,1000)):'';
  const L=(it.fabric||'').length, fs=L>30?'15pt':L>18?'18pt':'23pt';
  return `<div class="lbl">
  <div class="lp">${src?(canvas?`<div class="lpimg" style="background-image:url('${src}')"></div>`:`<img src="${src}" alt="" onerror="this.style.visibility='hidden'">`):'<div class="noph">ไม่มีรูป</div>'}<div class="lcap">${it.kind==='color'?'รูปสีผ้า':it.kind==='label'?'รูปป้าย':''}</div></div>
  <div class="lr">
    <div class="lh"><span class="lt ${out?'o':''}">${out?'ผ้าออก':'ผ้าเข้า'}</span><img class="llogo" src="${LOGO}" alt="FORMKO"><span class="ld">${esc(thDate(rec.date))}</span></div>
    <div class="lf" style="font-size:${fs}">${esc(it.fabric)}</div>
    <div class="lc"><span>สี <b>${esc(it.color||'-')}</b></span><span>Lot <b>${esc(it.lot||'-')}</b></span></div>
    ${(it.order||it.customer||it.purpose)?`<div class="lo"><div><small>สำหรับออเดอร์</small><b>${esc(it.order||'-')}</b>${it.customer?` &nbsp;<small>ลูกค้า</small><b>${esc(it.customer)}</b>`:''}</div>${it.purpose?`<div><small>ใช้ทำ</small>${esc(it.purpose)}</div>`:''}</div>`:''}
    <div class="lq"><div><small>จำนวนม้วน</small><b>${it.rolls?fmtNum(it.rolls):'-'}</b> ม้วน</div><div><small>ปริมาณรวม</small><b>${it.qty?fmtNum(it.qty):'-'}</b> ${esc(it.unit||'')}</div>${tag?`<div class="ltag">${tag}</div>`:''}</div>
    <div class="lm"><div>${out?'เบิกให้':'ร้าน'}: <b>${esc(rec.partner||'-')}</b> &nbsp; ${out?'ออเดอร์':'เลขบิล'}: <b>${esc(rec.ref||'-')}</b></div>
      <div>ผู้บันทึก: ${esc(rec.recorder||'-')} · รายการ ${i+1}/${N}</div><div>รหัส ${esc(rec.id||'-')}</div></div>
    ${qr?`<div class="lqr">${qr}สแกนดูรูป</div>`:''}
  </div></div>`;
}
function waitImgs(el){
  const ps=[...el.querySelectorAll('img')].map(i=>i.complete?1:new Promise(r=>{i.addEventListener('load',r);i.addEventListener('error',r);}));
  return Promise.race([Promise.all(ps),new Promise(r=>setTimeout(r,8000))]);
}

/* ---------- PDF → Google Drive → LINE ---------- */
const LIBS={h2c:'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js',jspdf:'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js'};
const libP={};
function loadScript(src){ return libP[src] ||= new Promise((res,rej)=>{ const s=document.createElement('script'); s.src=src; s.onload=res; s.onerror=()=>{ delete libP[src]; rej(new Error('โหลดไลบรารีไม่ได้ (เช็คอินเทอร์เน็ต)')); }; document.head.appendChild(s); }); }
const imgCache={};
async function resolveImgs(rec){   // รูปจาก Drive → base64 (ให้พิมพ์/ทำ PDF ได้แน่นอน)
  if (DEMO) return;
  await Promise.all(rec.items.map(async it=>{
    if (!it.img || it.img.startsWith('data:')) return;
    imgCache[it.img] ||= fetch(SCRIPT_URL+'?action=img&id='+encodeURIComponent(it.img)).then(r=>r.json()).then(r=>r.ok?r.data:'').catch(()=>'');
    const d=await imgCache[it.img]; if (d) it.img=d;
  }));
}
const preload=src=>new Promise(r=>{ const i=new Image(); i.onload=i.onerror=r; i.src=src; });
$('#pmPdf').onclick=async()=>{
  if (!pr.copies.some(c=>c>0)) return;
  busy(true,t('makingPdf'));
  const area=$('#printArea');
  try{
    await Promise.all([loadScript(LIBS.h2c),loadScript(LIBS.jspdf)]);
    await resolveImgs(pr.rec);
    buildLabels(true); area.classList.add('render'); window.scrollTo(0,0);
    await Promise.all(pr.rec.items.filter(it=>it.img).map(it=>preload(it.img.startsWith('data:')?it.img:thumb(it.img,1000))));
    if (document.fonts && document.fonts.ready) await document.fonts.ready;
    await waitImgs(area);
    const labels=[...area.querySelectorAll('.lbl')];
    const pdf=new window.jspdf.jsPDF({unit:'mm',format:'a4',orientation:'portrait',compress:true});
    for (let i=0;i<labels.length;i++){
      const c=await html2canvas(labels[i],{scale:2,useCORS:true,backgroundColor:'#ffffff',logging:false,windowWidth:1000});
      if (i>0 && i%3===0) pdf.addPage();
      pdf.addImage(c.toDataURL('image/jpeg',0.88),'JPEG',0,(i%3)*99,210,99);
    }
    area.classList.remove('render');
    const r0=pr.rec, name=`ใบปะหน้าผ้า ${r0.date} ${r0.id&&!r0.id.startsWith('(')?r0.id:'ตัวอย่าง'}.pdf`;
    if (DEMO){ pdf.save(name); toast(t('pdfDemo')); }
    else {
      const data=pdf.output('datauristring').split(',')[1];
      const r=await fetch(SCRIPT_URL,{method:'POST',body:JSON.stringify({action:'pdf',id:r0.id,date:r0.date,name,data})}).then(r=>r.json());
      if (!r.ok) throw new Error(r.error||'error');
      showShare(r.url, labels.length); cacheRows=null;
    }
  }catch(e){ toast(t('fail')+e.message,'bad'); }
  finally{ area.classList.remove('render'); busy(false); }
};
function showShare(url,n){
  const r=pr.rec, out=r.type==='OUT';
  const msg=`🖨 รบกวนพิมพ์ใบปะหน้าผ้า (${out?'ผ้าออก':'ผ้าเข้า'}) ${thDate(r.date)}\n`
    + r.items.map(it=>'• '+it.fabric+(it.color?' สี'+it.color:'')+(it.lot?' Lot '+it.lot:'')
        +((it.order||it.customer||it.purpose)?'\n   สำหรับ '+[it.order&&('ออเดอร์ '+it.order),it.customer,it.purpose].filter(Boolean).join(' · '):'')).join('\n')
    + `\nรวม ${n} ใบ (A4 ${Math.ceil(n/3)} แผ่น)\n${url}`;
  $('#pmUrl').value=url; $('#pmOpen').href=url;
  $('#pmLine').href='https://line.me/R/share?text='+encodeURIComponent(msg);
  $('#pmCopy').onclick=async()=>{ try{ await navigator.clipboard.writeText(msg); }catch(e){ $('#pmUrl').select(); document.execCommand('copy'); } toast(t('copied'),'ok'); };
  $('#pmShare').classList.remove('hidden');
  $('#pmShare').scrollIntoView({behavior:'smooth',block:'nearest'});
}

/* ---------- ui helpers ---------- */
let tt;
function toast(msg,kind=''){ const e=$('#toast'); e.textContent=msg; e.className='toast '+kind; e.style.display='block'; clearTimeout(tt); tt=setTimeout(()=>e.style.display='none',3200); }
function busy(on,txt){ $('#busyTxt').textContent=txt||t('saving'); $('#busy').style.display=on?'flex':'none'; $('#btnSave').disabled=on; }

/* ---------- start ---------- */
$('#hdrLogo').src = LOGO;
$('#fDate').value = today();
$('#hTo').value = today(); $('#hFrom').value = addDays(today(),-6);
$('#fRecorder').value = store('fab_recorder') || '';
$('#demoBox').classList.toggle('hidden', !DEMO);
items=[newItem()];
applyLang();
if (!DEMO) loadRows();
</script>
