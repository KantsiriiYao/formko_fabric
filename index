<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>บันทึกผ้าเข้า-ออก | Formko</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js" defer></script>
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;600;700&family=Padauk:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--navy:#242960;--green:#06693A;--out:#C2410C;--bg:#F3F4F8;--card:#fff;--line:#E2E4EC;--ink:#1D1F33;--mute:#6B6F85;--red:#C62828}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Sarabun','Padauk',system-ui,sans-serif;font-size:17px;-webkit-tap-highlight-color:transparent}
body.my{font-family:'Padauk','Sarabun',system-ui,sans-serif;line-height:1.7}
header{background:var(--navy);color:#fff;padding:12px 16px;display:flex;align-items:center;gap:10px;position:sticky;top:0;z-index:20}
header .logo{background:#fff;padding:3px 7px;border-radius:8px;display:flex;flex:none}
header .logo img{height:34px;display:block}
header h1{font-size:18px;margin:0;flex:1;font-weight:700}
.lang{display:flex;background:rgba(255,255,255,.15);border-radius:20px;padding:2px}
.lang button{border:0;background:none;color:#fff;padding:5px 10px;border-radius:18px;font:inherit;font-size:13px;cursor:pointer}
.lang button.on{background:#fff;color:var(--navy);font-weight:700}
nav{display:flex;background:#fff;border-bottom:1px solid var(--line);position:sticky;top:52px;z-index:19}
nav button{flex:1;border:0;background:none;padding:12px 4px;font:inherit;font-size:15px;color:var(--mute);border-bottom:3px solid transparent;cursor:pointer}
nav button.on{color:var(--navy);border-bottom-color:var(--green);font-weight:700}
main{max-width:720px;margin:0 auto;padding:14px 16px 110px}
.demo{background:#FFF4E5;border:1px solid #F5C27A;color:#8A4B00;padding:8px 12px;border-radius:10px;font-size:14px;margin-bottom:12px}
.card{background:var(--card);border-radius:14px;padding:14px;margin-bottom:12px;box-shadow:0 1px 2px rgba(0,0,0,.05)}
.card h3{margin:0 0 10px;font-size:16px;color:var(--navy)}
.type{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.type button{border:2px solid var(--line);background:#fff;border-radius:14px;padding:14px 6px;font:inherit;font-size:19px;font-weight:700;color:var(--mute);cursor:pointer}
.type button .ic{display:block;font-size:26px}
.type button.on.in{border-color:var(--green);background:var(--green);color:#fff}
.type button.on.out{border-color:var(--out);background:var(--out);color:#fff}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.full{grid-column:1/-1}
label.f{display:block;font-size:14px;color:var(--mute);margin-bottom:4px}
label.f .req{color:var(--red)}
input,select,textarea{width:100%;font:inherit;font-size:17px;padding:10px 11px;border:1.5px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--navy)}
.err{border-color:var(--red)!important;background:#FFF5F5}
.item{border:1.5px solid var(--line);border-radius:14px;padding:12px;margin-bottom:12px;background:#FAFBFD}
.item-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.item-h b{background:var(--navy);color:#fff;border-radius:8px;padding:2px 10px;font-size:14px}
.xbtn{border:0;background:#FDECEC;color:var(--red);border-radius:8px;padding:6px 12px;font:inherit;font-size:14px;cursor:pointer}
.photos{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px}
.ph{position:relative;width:86px;height:86px;border-radius:10px;overflow:hidden;background:#ddd}
.ph img{width:100%;height:100%;object-fit:cover;cursor:zoom-in}
.ph button{position:absolute;top:3px;right:3px;width:24px;height:24px;border-radius:50%;border:0;background:rgba(0,0,0,.6);color:#fff;font-size:14px;line-height:1;cursor:pointer}
.addph{width:86px;height:86px;border:2px dashed #A9ADC4;border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--navy);font-size:12px;text-align:center;cursor:pointer;background:#fff;padding:4px}
.addph span{font-size:26px;line-height:1}
.addph.need{border-color:var(--red);background:#FFF5F5}
.addph input{display:none}
.addbtn{width:100%;border:2px dashed var(--green);background:#EEF7F2;color:var(--green);border-radius:12px;padding:12px;font:inherit;font-weight:700;cursor:pointer}
.savebar{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid var(--line);padding:10px 16px calc(10px + env(safe-area-inset-bottom));z-index:15}
.savebar .row{display:flex;gap:10px;max-width:688px;margin:0 auto}
.savebar button{display:block;flex:1;border:0;border-radius:14px;padding:15px;font:inherit;font-size:19px;font-weight:700;color:#fff;background:var(--green);cursor:pointer}
.savebar button.out{background:var(--out)}
.savebar #btnPrintNow{flex:none;background:#fff;color:var(--navy);border:2px solid var(--navy);padding:13px 16px;font-size:17px}
.savebar button:disabled{opacity:.5}
.filters{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.chips{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}
.chip{border:1.5px solid var(--line);background:#fff;border-radius:20px;padding:6px 14px;font:inherit;font-size:14px;cursor:pointer}
.chip.on{background:var(--navy);border-color:var(--navy);color:#fff}
.day{font-weight:700;color:var(--navy);margin:16px 2px 8px;display:flex;justify-content:space-between;font-size:15px}
.day span{color:var(--mute);font-weight:400}
.rec{background:#fff;border-radius:14px;padding:12px;margin-bottom:10px;border-left:5px solid var(--green)}
.rec.out{border-left-color:var(--out)}
.rec-h{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;font-size:14px;color:var(--mute);margin-bottom:8px}
.badge{color:#fff;background:var(--green);border-radius:6px;padding:1px 8px;font-weight:700;font-size:13px}
.rec.out .badge{background:var(--out)}
.rec-h .who{color:var(--ink);font-weight:600}
.line{display:flex;gap:10px;align-items:center;padding:6px 0;border-top:1px dashed var(--line)}
.line img{width:56px;height:56px;border-radius:8px;object-fit:cover;background:#eee;cursor:zoom-in;flex:none}
.line .noimg{width:56px;height:56px;border-radius:8px;background:#EEF0F5;display:flex;align-items:center;justify-content:center;color:#A9ADC4;flex:none}
.line .nm{font-weight:600}
.line .sub{font-size:13px;color:var(--mute)}
.line .q{margin-left:auto;text-align:right;font-weight:700;white-space:nowrap}
.rec a{color:var(--navy);font-size:13px}
.note{font-size:13px;color:var(--mute);margin-top:6px}
table{width:100%;border-collapse:collapse;font-size:14px;background:#fff;border-radius:12px;overflow:hidden}
th,td{padding:8px 6px;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}
th{background:var(--navy);color:#fff;font-weight:600;font-size:13px}
td.n,th.n{text-align:right;white-space:nowrap}
td img{width:40px;height:40px;object-fit:cover;border-radius:6px;cursor:zoom-in;display:block}
.neg{color:var(--red);font-weight:700}
.zero{color:#A9ADC4}
.empty{text-align:center;color:var(--mute);padding:30px 10px}
.toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:12px 18px;border-radius:12px;font-size:15px;z-index:50;display:none;max-width:90vw;text-align:center}
.toast.ok{background:var(--green)}.toast.bad{background:var(--red)}
.busy{position:fixed;inset:0;background:rgba(20,22,40,.55);display:none;align-items:center;justify-content:center;z-index:60;color:#fff;flex-direction:column;gap:12px;font-size:16px}
.spin{width:44px;height:44px;border:4px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:s 1s linear infinite}
@keyframes s{to{transform:rotate(360deg)}}
.lb{position:fixed;inset:0;background:rgba(0,0,0,.9);display:none;align-items:center;justify-content:center;z-index:70;padding:16px}
.lb img{max-width:100%;max-height:85vh;border-radius:8px}
.lb a{position:absolute;bottom:20px;color:#fff;font-size:14px}

/* ---------- modal พิมพ์ ---------- */
.modal{position:fixed;inset:0;background:rgba(20,22,40,.55);display:none;align-items:flex-end;justify-content:center;z-index:65}
.mbox{background:#fff;width:100%;max-width:600px;border-radius:18px 18px 0 0;padding:16px 16px calc(16px + env(safe-area-inset-bottom));max-height:88vh;overflow:auto}
.mbox h3{margin:0 0 4px;color:var(--navy);font-size:18px}
.mbox .hint{font-size:13px;color:var(--mute);margin-bottom:8px}
.prow{display:flex;align-items:center;gap:10px;padding:10px 0;border-top:1px solid var(--line)}
.prow img,.prow .noimg{width:48px;height:48px;border-radius:8px;object-fit:cover;flex:none;background:#EEF0F5;display:flex;align-items:center;justify-content:center;color:#A9ADC4}
.pn{flex:1;min-width:0}.pn .sub{font-size:13px;color:var(--mute)}
.stp{display:flex;align-items:center;gap:4px}
.stp button{width:38px;height:38px;border-radius:10px;border:1.5px solid var(--line);background:#fff;font-size:20px;cursor:pointer;color:var(--ink)}
.stp input{width:56px;text-align:center;padding:8px 4px}
.mact{display:grid;grid-template-columns:1fr 2fr;gap:10px;margin-top:14px}
.mact button{border:0;border-radius:12px;padding:14px;font:inherit;font-weight:700;font-size:16px;cursor:pointer}
#pmClose{background:#EEF0F5;color:var(--ink)}#pmPrint{background:var(--navy);color:#fff}#pmPrint:disabled{opacity:.5}
.prbtn{border:1.5px solid var(--navy);background:#fff;color:var(--navy);border-radius:8px;padding:5px 12px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}
.rec-f{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:8px}

/* ---------- ใบปะหน้าผ้า 1/3 A4 ---------- */
#printArea{display:none}
#printArea.render{display:block;position:fixed;left:0;top:0;z-index:-1;width:210mm}
.lpimg{width:58mm;height:80mm;border:.3mm solid #000;border-radius:2mm;background:#fff center/cover no-repeat}
.llogo{height:9mm;display:block}
.btnLine{display:block;width:100%;margin-top:10px;border:0;border-radius:12px;padding:14px;font:inherit;font-weight:700;font-size:16px;background:#06C755;color:#fff;cursor:pointer;text-align:center;text-decoration:none}
.share{margin-top:12px;padding:12px;border-radius:12px;background:#EEF9F2;border:1.5px solid #06C755}
.share b{color:#05833A}
.share input{margin:6px 0;font-size:13px}
.sact{display:grid;grid-template-columns:2fr 1fr 1fr;gap:6px}
.sact a,.sact button{border:0;border-radius:10px;padding:11px 4px;font:inherit;font-size:14px;font-weight:700;text-align:center;text-decoration:none;cursor:pointer;background:#fff;color:var(--navy);border:1.5px solid var(--line)}
.sact .line{background:#06C755;color:#fff;border-color:#06C755}
@media print{
  @page{size:A4 portrait;margin:0}
  html,body{background:#fff!important}
  body>*:not(#printArea){display:none!important}
  #printArea{display:block!important}
}
.lbl{width:210mm;height:99mm;padding:6mm 8mm;display:grid;grid-template-columns:58mm 1fr;gap:6mm;border-bottom:.3mm dashed #888;overflow:hidden;break-inside:avoid;page-break-inside:avoid;color:#000;background:#fff;font-family:'Sarabun',sans-serif;line-height:1.25;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.lbl:nth-child(3n){border-bottom:0}
.lbl:nth-child(3n):not(:last-child){break-after:page;page-break-after:always}
.lp{display:flex;flex-direction:column;min-height:0}
.lp img,.lp .noph{width:58mm;height:80mm;object-fit:cover;border:.3mm solid #000;border-radius:2mm;display:block}
.lp .noph{display:flex;align-items:center;justify-content:center;color:#999;font-size:11pt}
.lcap{font-size:9pt;text-align:center;margin-top:.8mm}
.lr{position:relative;display:flex;flex-direction:column;gap:2mm;min-width:0}
.lh{display:flex;align-items:center;gap:3mm;border-bottom:.5mm solid #000;padding-bottom:1.5mm}
.lt{background:#06693A;color:#fff;font-weight:700;font-size:13pt;padding:.3mm 3mm;border-radius:1.5mm}
.lt.o{background:#C2410C}
.lb2{font-weight:700;letter-spacing:1mm;font-size:11pt;color:#242960}
.ld{margin-left:auto;font-weight:700;font-size:14pt}
.lf{font-weight:700;line-height:1.15;word-break:break-word;max-height:25mm;overflow:hidden}
.lc{display:flex;gap:8mm;font-size:14pt}.lc b{font-size:17pt}
.lq{display:flex;gap:3mm;align-items:stretch}
.lq>div{border:.4mm solid #000;border-radius:2mm;padding:.8mm 3mm;font-size:12pt;line-height:1.1}
.lq small{display:block;font-size:9pt;color:#333}
.lq b{font-size:22pt}
.lq .ltag{display:flex;align-items:center;font-weight:700;font-size:14pt;background:#000;color:#fff}
.lo{border-left:1.5mm solid #242960;background:#EEF0F8;padding:.8mm 3mm;font-size:13pt;line-height:1.3}
.lo>div{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lo small{font-size:9pt;color:#333;margin-right:1.5mm}.lo b{font-size:15pt}
.lm{margin-top:auto;font-size:10pt;line-height:1.4;padding-right:25mm}
.lqr{position:absolute;right:0;bottom:0;text-align:center;font-size:7pt}
.lqr img{width:21mm;height:21mm;image-rendering:pixelated;display:block}
.hidden{display:none!important}
@media(max-width:420px){.grid{grid-template-columns:1fr 1fr}.ph,.addph{width:78px;height:78px}}
</style>
</head>
<body>
<header>
  <div class="logo"><img id="hdrLogo" alt="FORMKO"></div>
  <h1 data-i="title"></h1>
  <div class="lang"><button id="lgTh">ไทย</button><button id="lgMy">မြန်မာ/EN</button></div>
</header>
<nav>
  <button data-pg="form" class="on" data-i="tabForm"></button>
  <button data-pg="hist" data-i="tabHist"></button>
  <button data-pg="bal" data-i="tabBal"></button>
</nav>

<main>
  <div id="demoBox" class="demo hidden" data-i="demo"></div>

  <!-- ========== หน้าบันทึก ========== -->
  <section id="pg-form">
    <div class="type">
      <button class="in on" data-type="IN"><span class="ic">📥</span><span data-i="in"></span></button>
      <button class="out" data-type="OUT"><span class="ic">📤</span><span data-i="out"></span></button>
    </div>

    <div class="card">
      <div class="grid">
        <div><label class="f"><span data-i="date"></span> <span class="req">*</span></label><input type="date" id="fDate"></div>
        <div><label class="f"><span data-i="recorder"></span> <span class="req">*</span></label><input id="fRecorder" list="dlRecorder" autocomplete="off"></div>
        <div><label class="f"><span id="lbPartner"></span></label><input id="fPartner" list="dlPartner" autocomplete="off"></div>
        <div><label class="f"><span id="lbRef"></span></label><input id="fRef" autocomplete="off"></div>
      </div>
    </div>

    <div class="card" id="billCard">
      <h3 data-i="billPhoto"></h3>
      <div class="photos" id="billPhotos"></div>
    </div>

    <div id="items"></div>
    <button class="addbtn" id="addItem">＋ <span data-i="addItem"></span></button>

    <div class="card" style="margin-top:12px">
      <label class="f" data-i="note"></label>
      <textarea id="fNote" rows="2"></textarea>
    </div>
  </section>

  <!-- ========== หน้าประวัติ ========== -->
  <section id="pg-hist" class="hidden">
    <div class="card">
      <div class="filters">
        <div><label class="f" data-i="from"></label><input type="date" id="hFrom"></div>
        <div><label class="f" data-i="to"></label><input type="date" id="hTo"></div>
        <div class="full"><input id="hSearch" data-ip="searchPh"></div>
      </div>
      <div class="chips" id="hType">
        <button class="chip on" data-v="ALL" data-i="all"></button>
        <button class="chip" data-v="IN" data-i="in"></button>
        <button class="chip" data-v="OUT" data-i="out"></button>
        <button class="chip" id="hReload" style="margin-left:auto">⟳ <span data-i="reload"></span></button>
      </div>
    </div>
    <div id="histList"></div>
  </section>

  <!-- ========== หน้ายอดคงเหลือ ========== -->
  <section id="pg-bal" class="hidden">
    <div class="card">
      <input id="bSearch" data-ip="searchPh">
      <div class="chips"><button class="chip" id="bReload">⟳ <span data-i="reload"></span></button></div>
    </div>
    <div id="balList"></div>
  </section>
</main>

<div class="savebar" id="saveBar"><div class="row"><button id="btnPrintNow" type="button" data-i="printNow"></button><button id="btnSave" data-i="save"></button></div></div>
<div class="toast" id="toast"></div>
<div class="busy" id="busy"><div class="spin"></div><div id="busyTxt"></div></div>
<div class="lb" id="lb"><img id="lbImg" alt=""><a id="lbLink" target="_blank" rel="noopener"></a></div>
<div class="modal" id="pm"><div class="mbox">
  <h3 id="pmTitle"></h3>
  <div class="hint" data-i="printHint"></div>
  <div id="pmList"></div>
  <button class="chip" id="pmRolls" style="margin-top:8px" data-i="byRolls"></button>
  <div class="mact"><button id="pmClose" data-i="close"></button><button id="pmPrint"></button></div>
  <button class="btnLine" id="pmPdf" type="button" data-i="sendLine"></button>
  <div class="share hidden" id="pmShare">
    <b data-i="pdfReady"></b>
    <input id="pmUrl" readonly>
    <div class="sact"><a id="pmLine" class="line" target="_blank" rel="noopener" data-i="lineBtn"></a><button id="pmCopy" type="button" data-i="copy"></button><a id="pmOpen" target="_blank" rel="noopener" data-i="open"></a></div>
  </div>
</div></div>
<div id="printArea"></div>

<datalist id="dlRecorder"></datalist>
<datalist id="dlPartner"></datalist>
<datalist id="dlFabric"></datalist>
<datalist id="dlColor"></datalist>
<datalist id="dlOrder"></datalist>
<datalist id="dlCustomer"></datalist>
<datalist id="dlPurpose"></datalist>

<script>
