function compress(file, max=1600, q=0.75){
  return new Promise((res,rej) => {
    const img = new Image(), url = URL.createObjectURL(file);
    img.onload = () => {
      const s = Math.min(1, max/Math.max(img.width,img.height));
      const c = document.createElement('canvas');
      c.width = Math.round(img.width*s); c.height = Math.round(img.height*s);
      c.getContext('2d').drawImage(img,0,0,c.width,c.height);
      URL.revokeObjectURL(url); res(c.toDataURL('image/jpeg',q));
    };
    img.onerror = e => { URL.revokeObjectURL(url); rej(e); };
    img.src = url;
  });
}
function photoBox(list, onChange, labelKey, need){
  const wrap = document.createElement('div'); wrap.className='photos';
  list.forEach((p,i) => {
    const d=document.createElement('div'); d.className='ph';
    d.innerHTML = `<img src="${p}" alt=""><button type="button">✕</button>`;
    d.querySelector('img').onclick = () => openLb(p);
    d.querySelector('button').onclick = () => { list.splice(i,1); onChange(); };
    wrap.appendChild(d);
  });
  const add=document.createElement('label'); add.className='addph'+(need&&!list.length?' need':'');
  add.innerHTML = `<span>📷</span>${esc(t('takePhoto'))}<input type="file" accept="image/*" capture="environment" multiple>`;
  add.querySelector('input').onchange = async e => {
    for (const f of e.target.files){ try{ list.push(await compress(f)); }catch(err){} }
    e.target.value=''; onChange();
  };
  wrap.appendChild(add);
  return wrap;
}
