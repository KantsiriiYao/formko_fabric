$('#btnSave').onclick = async () => {
  const recorder=$('#fRecorder').value.trim();
  if (!recorder){ $('#fRecorder').classList.add('err'); $('#fRecorder').focus(); return toast(t('needRecorder'),'bad'); }
  let bad=false, badPhoto=false;
  const filled = items.filter(it => it.fabric.trim() || it.qty || it.rolls || it.photos.length || it.colorPhotos.length);
  if (!filled.length) bad=true;
  filled.forEach(it => {
    if (!it.fabric.trim() || (!(+it.qty>0) && !(+it.rolls>0))) bad=true;
    if (type==='IN' && !it.photos.length) badPhoto=true;
  });
  if (bad){ markErrors(); return toast(t('needItem'),'bad'); }
  if (badPhoto) return toast(t('needPhoto'),'bad');

  const payload = {
    action:'save', type, date:$('#fDate').value||today(), recorder,
    partner:$('#fPartner').value.trim(), ref:$('#fRef').value.trim(), note:$('#fNote').value.trim(),
    billPhotos: type==='IN'?billPhotos:[],
    items: filled.map(it => ({fabric:it.fabric.trim(),color:it.color.trim(),lot:it.lot.trim(),rolls:it.rolls,qty:it.qty,unit:it.unit,order:it.order.trim(),customer:it.customer.trim(),purpose:it.purpose.trim(),photos:it.photos,colorPhotos:it.colorPhotos}))
  };
  busy(true);
  let rec=null;
  try{
    let res;
    if (DEMO){ res = demoSave(payload); }
    else {
      res = await fetch(SCRIPT_URL,{method:'POST',body:JSON.stringify(payload)}).then(r=>r.json());
      if (!res.ok) throw new Error(res.error||'error');
    }
    store('fab_recorder', recorder);
    rec = recFromPayload(payload, res.id, res.folderUrl);
    resetForm(); cacheRows=null; toast(t('saved'),'ok');
  }catch(e){ toast(t('fail')+e.message,'bad'); }
  busy(false);
  if (rec) openPrint(rec, true);
};
